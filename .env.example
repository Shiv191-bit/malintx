# MALINT-X configuration. Copy to .env and fill in what you use. NEVER commit .env.
# Every integration is optional: with no keys the full static-analysis pipeline still works.

# ---- Threat intelligence (passive lookups; sends sample hash + extracted indicators to the provider) ----
# Enabled per analysis by the user; keys alone never cause data to leave the host.
VT_API_KEY=
SHODAN_API_KEY=
ABUSECH_AUTH_KEY=            # abuse.ch Auth-Key for MalwareBazaar
KOODOUS_TOKEN=               # experimental adapter
VT_RATE_LIMIT_PER_MINUTE=4   # free VirusTotal tier

# ---- AI-assisted interpretation (optional, advisory; sends bounded evidence excerpts, never the APK) ----
MALINTX_AI_PROVIDER=none     # none | anthropic | gemini | openai_compatible
ANTHROPIC_API_KEY=
MALINTX_ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
MALINTX_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
MALINTX_OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint, incl. local servers
MALINTX_OPENAI_MODEL=gpt-4o-mini

# ---- Decompilers (optional; bytecode analysis works without them) ----
# MALINTX_JAVA=C:\path\to\java.exe
# MALINTX_JADX=C:\path\to\jadx.bat
# MALINTX_APKTOOL=C:\path\to\apktool.bat

# ---- Limits ----
MALINTX_MAX_UPLOAD_MB=150
MALINTX_ANALYSIS_TIMEOUT_S=600
MALINTX_WORKER_MEMORY_MB=3072
MALINTX_WORKER_THREADS=2

# ---- API / security ----
MALINTX_API_HOST=127.0.0.1
MALINTX_API_PORT=8750
MALINTX_API_TOKEN=           # set to require "Authorization: Bearer <token>" (required if you bind beyond localhost)
# MALINTX_TRUSTED_CERT_SHA256=aabbcc...,ddeeff...   # signer fingerprints you trust (halves capability weights; never zeroes a score)
MALINTX_DATA_DIR=./var
MALINTX_LOG_LEVEL=INFO
