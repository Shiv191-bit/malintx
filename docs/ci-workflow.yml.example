name: ci
on:
  push: { branches: [main] }
  pull_request:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.14" }
      - run: pip install -r requirements.lock.txt ruff pytest
      - run: pip install -e . --no-deps
      - run: ruff check malintx tests
      - run: pytest tests -q   # no network, API keys, Java or real samples needed
